# Runtime connection must use the restricted hermes_app role.
DATABASE_URL=postgresql://hermes_app:replace-me@host/hermespass?sslmode=require

# Operator-only migration connection; never expose this to Vercel functions.
MIGRATION_DATABASE_URL=postgresql://owner:replace-me@host/hermespass?sslmode=require

# Neon Auth project endpoint and an environment-specific cookie secret.
NEON_AUTH_BASE_URL=https://your-neon-auth-endpoint
NEON_AUTH_COOKIE_SECRET=

# Base64url-encoded 32-byte environment-specific KEK.
HERMES_KEK_V1=
HERMES_KEY_ENVIRONMENT=development
HERMES_ISSUER_ORIGIN=http://localhost:3000
